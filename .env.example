# ============ إعدادات NERD ============
# انسخ هذا الملف إلى .env ثم عدّل القيم. لا تضع أي مفتاح حقيقي داخل الكود أو
# داخل مستودع Git؛ ملف .env مستثنى من التتبع.

# --- منافذ التشغيل ---
# منفذ الخادم (API) الداخلي في التطوير. في الاستضافة استخدم PORT الذي توفره المنصة.
API_PORT=8787
# منفذ الواجهة في التطوير (Vite) — لا تستخدمه في الإنتاج.
PORT=3000

# --- البيانات والتخزين ---
# مجلد البيانات الدائم (قاعدة SQLite + الملفات المرفوعة).
# في الإنتاج اربطه بقرص دائم، مثل /data على Render.
# DATA_DIR=./data
# مسار ملف SQLite. الافتراضي: $DATA_DIR/nerd.db
# DATABASE_PATH=./data/nerd.db

# --- لوحة المطوّر ---
# معرّف الحساب الوحيد الذي يملك صلاحية لوحة المطوّر. لا يُمنح الدور من الواجهة.
# الافتراضي 11. يمكن ضبطه قبل أول تشغيل؛ تغييره لاحقًا يغيّر صاحب الوصول.
# ADMIN_USER_ID=11

# --- الجلسات والكوكيز ---
# اجعلها 1 فقط إذا كان الموقع يعمل على HTTPS مباشرة دون وكيل أمامي
COOKIE_SECURE=0

# --- رابط التطبيق (يُستخدم في روابط إعادة تعيين كلمة المرور) ---
# APP_URL=https://your-domain.example

# --- إرسال البريد (استعادة كلمة المرور) ---
# بدون هذين المتغيرين يعمل الخادم لكن تسليم الرسالة لا يحدث؛ يُسجَّل نص
# الرسالة في سجل الخادم (وضع تطوير) وتُبلَّغ الواجهة بذلك بشفافية.
# EMAIL_API_KEY=
# EMAIL_FROM="NERD <no-reply@your-domain.example>"

# --- الكتب ورفع الملفات (المرحلة 2) ---
# الحد الأقصى لحجم الملف الواحد بالبايت (افتراضي 50 ميغابايت)
# MAX_UPLOAD_BYTES=52428800
# الحد الأقصى لعدد الصور في الرفع الواحد (افتراضي 30)
# MAX_FILES_PER_BOOK=30
# محرك OCR للصور: tesseract (يعمل محليًا، الافتراضي)
# OCR_PROVIDER=tesseract

# --- حدود المحتوى الدراسي (المرحلة 7) ---
# MAX_CONTENT_IMAGE_BYTES=26214400
# MAX_CONTENT_PDF_BYTES=52428800
# MAX_VIDEO_BYTES=209715200
# MAX_CONTENT_FILES=30
# MAX_CONTENT_TEXT_CHARS=100000
# MAX_CONTENT_PAGES=250

# --- معالجة الفيديو الطويل ---
# 0 = بلا حد للدقائق (الافتراضي). يمكن للمشرف وضع حد أعلى عند الحاجة.
# MAX_VIDEO_SECONDS=0
# 0 = بلا حد لعدد الإطارات. يمكن ضبطه لتقليل زمن المعالجة على أجهزة ضعيفة.
# MAX_VIDEO_FRAMES=0
# إطار كل كم ثانية، ومدة المقطع الواحد، ومدة مقطع تفريغ الصوت.
# VIDEO_FRAME_INTERVAL_SECONDS=8
# VIDEO_SEGMENT_SECONDS=180
# VIDEO_TRANSCRIBE_CHUNK_SECONDS=600

# --- مزوّد الذكاء الاصطناعي (Groq) ---
# لا يوجد مفتاح على الخادم إطلاقًا: كل مستخدم يضيف مفتاح Groq الخاص به من داخل التطبيق،
# ويُحفظ في متصفحه فقط ثم يُرسل مع كل طلب في ترويسة X-AI-Key ولا يُخزَّن في قاعدة البيانات.
# هذه المتغيّرات تضبط المزوّد والنموذج المسموح فقط. أي خدمة متوافقة مع OpenAI تعمل،
# لكن الواجهة تفترض Groq في الرسائل ورابط الحصول على المفتاح.
AI_PROVIDER=Groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_MODEL=openai/gpt-oss-120b
AI_ALLOWED_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
AI_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=1600
# درس «اسأل المعلم» يُعاد كـJSON كامل، لذا له حد رموز أكبر مستقل.
# AI_LESSON_MAX_OUTPUT_TOKENS=4500
# ميزانية سياق النموذج وحد الطلب. لا تُفترض حدود نموذج معيّن داخل الكود.
# AI_CONTEXT_TOKENS=16384
# AI_MAX_REQUEST_CHARS= (يُحسب تلقائيًا من السياق عند تركه فارغًا)
# إعادة المحاولة والضغط: 4 محاولات، انتظار تصاعدي، وطلبان متزامنان كحد افتراضي.
# AI_MAX_ATTEMPTS=4
# AI_RETRY_BASE_MS=900
# AI_MAX_CONCURRENT=2
# اختياري: نموذج رؤية لقراءة الصور والمعادلات (مثل meta-llama/llama-4-scout-17b-16e-instruct)
# AI_VISION_MODEL=
# نموذج تفريغ الصوت في Groq. اترك اللغة فارغة لكشف العربية/الإنجليزية تلقائيًا.
# AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# AI_TRANSCRIBE_LANGUAGE=

# --- حدود التلخيص الطويلة (تقنية) ---
# 0 = بلا حد ثابت لعدد الدفعات؛ تُعالج كل دفعات المحتوى الطويل وتُدمج هرميًا.
# AI_SUMMARY_BATCH_CHARS=8000
# AI_SUMMARY_MAX_BATCHES=0
# AI_SUMMARY_MERGE_GROUP=4

# --- نظام المزوّدين المزدوج (اختياري) ---
# عند تعيين PROVIDER_A_API_KEY وPROVIDER_A_MODEL (وكذلك B) يتحوّل التطبيق تلقائيًا
# إلى وضع مزوّدي الخادم، ولا يطلب مفتاحًا من المستخدم. المفاتيح هنا سرّية ولا تُرسل
# إلى المتصفح ولا تظهر في الردود أو السجلات. عند تركها فارغة يعمل نظام مفتاح
# المتصفح القديم كما هو دون أي تغيير.
# PROVIDER_A_NAME=Provider A
# PROVIDER_A_API_KEY=
# PROVIDER_A_BASE_URL=https://api.example-a.com/v1
# PROVIDER_A_MODEL=
# PROVIDER_A_VISION_MODEL=
# PROVIDER_B_NAME=Provider B
# PROVIDER_B_API_KEY=
# PROVIDER_B_BASE_URL=https://api.example-b.com/v1
# PROVIDER_B_MODEL=
# PROVIDER_B_VISION_MODEL=
# اختياري: نموذج مستقل لكل مهمة داخل المزوّد نفسه.
# A: المحادثة، اسأل المعلم، العربية، التعبير
# PROVIDER_A_MODEL_CHAT=
# PROVIDER_A_MODEL_TEACHER=
# PROVIDER_A_MODEL_ARABIC=
# PROVIDER_A_MODEL_EXPRESSION=
# B: الإنجليزية، الاختبارات، الملخصات، المحتوى، بقية أدوات الدراسة
# PROVIDER_B_MODEL_ENGLISH=
# PROVIDER_B_MODEL_TESTS=
# PROVIDER_B_MODEL_SUMMARIES=
# PROVIDER_B_MODEL_CONTENT=
# PROVIDER_B_MODEL_STUDY=
# B: الرؤية (يجب أن يدعم النموذج الصور حتى يُستخدم هذا المسار)
# PROVIDER_B_VISION_MODEL=

# --- الحد اليومي الافتراضي لكل مستخدم (قابل للتغيير من app_settings) ---
# AI_DAILY_LIMIT_PER_USER=30

# --- أسعار النموذج لكل مليون رمز لحساب التكلفة؛ اتركها 0 إن لم تكن معروفة ---
# AI_PRICE_INPUT_PER_MTOK=0
# AI_PRICE_OUTPUT_PER_MTOK=0
