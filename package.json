{
  "name": "nerd",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "NERD - نيرد | مساعد دراسي ذكي — مفاتيح AI لكل مستخدم على حدة",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
